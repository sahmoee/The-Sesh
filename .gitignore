# Secrets — NEVER commit
Secrets.xcconfig
*.secret.xcconfig
.env
.env.*
.dev.vars
*.p8
*.p12
*.cer
*.mobileprovision
AuthKey_*.p8
# Cloudflare worker local state (secrets live in Cloudflare)
_worker/**/.wrangler/
**/.wrangler/
# Xcode
build/
DerivedData/
.bbderived/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM
# SwiftPM
.build/
.swiftpm/
# Node
node_modules/
# macOS
.DS_Store

# macOS AppleDouble resource forks (created by zip/unzip round-trips)
._*
.AppleDouble

# Local build snapshots — keep on disk if you want them, never in git
.buildbuddy-backups/

# One-off patch exports are reproducible from git history
*.diff

# Worker has no package.json; a stray lockfile is always an artifact
_worker/**/package-lock.json
